*.mdb.meta

# ---------------------------------------------------------------
# Salidas de build y reportes de crash
# ---------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app
sysinfo.txt
crashlytics-build.properties
ExportedObj/

# ---------------------------------------------------------------
# Archivos locales de este proyecto
# ---------------------------------------------------------------
# Log suelto de un proceso externo en la raíz
/debug.log
# Archivos de trabajo de arte fuera de Assets (pesados; no los usa Unity).
# Si quieres versionarlos, usa Git LFS en lugar de quitar esta línea.
*.pxo

# Sistema operativo
Thumbs.db
Desktop.ini
.DS_Store
