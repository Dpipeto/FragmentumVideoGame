  m_Script: {fileID: 11500000, guid: c727d9fca1fed874ca8536539ef7890b, type: 3}
  m_Name: Dialogos_Esperanza
  m_EditorClassIdentifier: Fragmentum.Runtime::Fragmentum.Narrative.DialogueData
  lineas:
  - hablante: Kael
    texto: "Por primera vez nada quiere herirme. Me cuesta creerlo. Quiz\xE1 as\xED empieza la Esperanza."
    momento: 0
    duracion: 4.5
  - hablante: Kael
    texto: "Una casa con flores en la ventana. Antes de la guerra, \xE9l tambi\xE9n re\xEDa."
    momento: 1
    duracion: 4.5
  - hablante: Kael
    texto: "Cada fragmento encontr\xF3 su sitio. La Esperanza no borra lo que pas\xF3: lo deja crecer en otro lugar."
    momento: 3
    duracion: 4.5
