  m_Name: Dialogos_Tristeza
  m_EditorClassIdentifier: Fragmentum.Runtime::Fragmentum.Narrative.DialogueData
  lineas:
  - hablante: Kael
    texto: "[Apertura \xB7 Tristeza \xB7 pendiente de guion] Kael nombra la tristeza al entrar en Ciudad Sumergida."
    momento: 0
    duracion: 4.5
  - hablante: Kael
    texto: "[Eco de memoria \xB7 Tristeza \xB7 pendiente de guion]"
    momento: 1
    duracion: 4.5
  - hablante: Doncella del Lamento
    texto: "[Antes del jefe \xB7 Tristeza \xB7 pendiente de guion] Doncella del Lamento encarna la tristeza."
    momento: 2
    duracion: 4.5
  - hablante: Kael
    texto: "[Cierre \xB7 Tristeza \xB7 pendiente de guion] Kael reconoce la tristeza como parte de s\xED."
    momento: 3
    duracion: 4.5
