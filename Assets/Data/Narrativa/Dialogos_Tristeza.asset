  m_Script: {fileID: 11500000, guid: c727d9fca1fed874ca8536539ef7890b, type: 3}
  m_Name: Dialogos_Tristeza
  m_EditorClassIdentifier: Fragmentum.Runtime::Fragmentum.Narrative.DialogueData
  lineas:
  - hablante: Kael
    texto: "Una ciudad entera bajo el agua y ni una l\xE1grima en la superficie. As\xED de callada es la Tristeza."
    momento: 0
    duracion: 4.5
  - hablante: Kael
    texto: "Alguien deja una silla vac\xEDa en la mesa. Nadie la quita. Nadie la nombra."
    momento: 1
    duracion: 4.5
  - hablante: Doncella del Lamento
    texto: "\xC9l cerr\xF3 los ojos para no llorar, y la ciudad se hundi\xF3. \xBFVienes a cerrarlos t\xFA tambi\xE9n?"
    momento: 2
    duracion: 4.5
  - hablante: Kael
    texto: "Me dej\xE9 hundir y no me ahogu\xE9. La Tristeza pesa, pero tambi\xE9n sostiene."
    momento: 3
    duracion: 4.5
