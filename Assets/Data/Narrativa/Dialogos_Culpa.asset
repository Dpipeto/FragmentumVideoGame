MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c727d9fca1fed874ca8536539ef7890b, type: 3}
  m_Name: Dialogos_Culpa
  m_EditorClassIdentifier: Fragmentum.Runtime::Fragmentum.Narrative.DialogueData
  lineas:
  - hablante: Kael
    texto: "Aqu\xED nada se movi\xF3 desde el \xFAltimo disparo. Es la Culpa de otro\u2026 y la siento m\xEDa."
    momento: 0
    duracion: 4.5
  - hablante: Kael
    texto: "Una orden. Un s\xED. Un pueblo que ya no est\xE1. \xC9l lo recuerda cada d\xEDa con los ojos abiertos."
    momento: 1
    duracion: 4.5
  - hablante: Juez Silente
    texto: "No dicto sentencia. Solo te muestro lo que \xE9l se neg\xF3 a mirar."
    momento: 2
    duracion: 4.5
  - hablante: Kael
    texto: "Mirarlo no me destruy\xF3. La Culpa es un peso, no un nombre. Puedo cargarlo y seguir de pie."
    momento: 3
    duracion: 4.5
