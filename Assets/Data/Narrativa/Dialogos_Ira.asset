MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c727d9fca1fed874ca8536539ef7890b, type: 3}
  m_Name: Dialogos_Ira
  m_EditorClassIdentifier: Fragmentum.Runtime::Fragmentum.Narrative.DialogueData
  lineas:
  - hablante: Kael
    texto: "Este calor no es m\xEDo\u2026 y aun as\xED me empuja a correr. Si esto es la Ira, alguien la dej\xF3 encendida."
    momento: 0
    duracion: 4.5
  - hablante: Kael
    texto: "Una voz grita \xF3rdenes que no entiendo. Mis manos s\xED las entienden: se cierran solas."
    momento: 1
    duracion: 4.5
  - hablante: Centinela Ardiente
    texto: "\xC9l me dej\xF3 aqu\xED para que nadie tocara su rabia. T\xFA tampoco la tocar\xE1s."
    momento: 2
    duracion: 4.5
  - hablante: Kael
    texto: "La Ira no era el fuego. Era lo que \xE9l nunca dijo. La llevo conmigo, pero ya no me lleva ella."
    momento: 3
    duracion: 4.5
