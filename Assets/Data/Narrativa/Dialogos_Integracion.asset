  m_Script: {fileID: 11500000, guid: c727d9fca1fed874ca8536539ef7890b, type: 3}
  m_Name: Dialogos_Integracion
  m_EditorClassIdentifier: Fragmentum.Runtime::Fragmentum.Narrative.DialogueData
  lineas:
  - hablante: Kael
    texto: "Todo lo que vine a buscar estaba aqu\xED, esperando. La Integraci\xF3n no es ganarle: es dejar de huir."
    momento: 0
    duracion: 4.5
  - hablante: El Verdadero Soldado
    texto: "Eres lo que sobr\xF3 cuando me arranqu\xE9 el dolor. Eres un error."
    momento: 2
    duracion: 4.5
  - hablante: Kael
    texto: "No vine a reemplazarte ni a destruirte. La Integraci\xF3n era esto: caminar juntos hacia la misma luz."
    momento: 3
    duracion: 4.5
