  m_Name: Dialogos_Integracion
  m_EditorClassIdentifier: Fragmentum.Runtime::Fragmentum.Narrative.DialogueData
  lineas:
  - hablante: Kael
    texto: "[Apertura \xB7 Integraci\xF3n \xB7 pendiente de guion] Kael nombra la integraci\xF3n al entrar en El Espejo del Origen."
    momento: 0
    duracion: 4.5
  - hablante: Kael
    texto: "[Eco de memoria \xB7 Integraci\xF3n \xB7 pendiente de guion]"
    momento: 1
    duracion: 4.5
  - hablante: El Verdadero Soldado
    texto: "[Antes del jefe \xB7 Integraci\xF3n \xB7 pendiente de guion] El Verdadero Soldado encarna la integraci\xF3n."
    momento: 2
    duracion: 4.5
  - hablante: Kael
    texto: "[Cierre \xB7 Integraci\xF3n \xB7 pendiente de guion] Kael reconoce la integraci\xF3n como parte de s\xED."
    momento: 3
    duracion: 4.5
