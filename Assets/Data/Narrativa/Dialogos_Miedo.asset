  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c727d9fca1fed874ca8536539ef7890b, type: 3}
  m_Name: Dialogos_Miedo
  m_EditorClassIdentifier: Fragmentum.Runtime::Fragmentum.Narrative.DialogueData
  lineas:
  - hablante: Kael
    texto: "No veo mis propios pasos. Algo respira entre los \xE1rboles\u2026 o soy yo. Esto es el Miedo."
    momento: 0
    duracion: 4.5
  - hablante: Kael
    texto: "Una trinchera. Un silencio demasiado largo. \xC9l se qued\xF3 quieto para que no lo encontraran."
    momento: 1
    duracion: 4.5
  - hablante: Espectro del Pavor
    texto: "\xC9l aprendi\xF3 a desaparecer para seguir vivo. Yo soy todo lo que dej\xF3 escondido."
    momento: 2
    duracion: 4.5
  - hablante: Kael
    texto: "El Miedo no se fue: dej\xF3 de decidir por m\xED. Puedo andar en la sombra sin perderme en ella."
    momento: 3
    duracion: 4.5
