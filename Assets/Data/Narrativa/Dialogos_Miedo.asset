  m_Name: Dialogos_Miedo
  m_EditorClassIdentifier: Fragmentum.Runtime::Fragmentum.Narrative.DialogueData
  lineas:
  - hablante: Kael
    texto: "[Apertura \xB7 Miedo \xB7 pendiente de guion] Kael nombra el miedo al entrar en Bosque Tenebroso."
    momento: 0
    duracion: 4.5
  - hablante: Kael
    texto: "[Eco de memoria \xB7 Miedo \xB7 pendiente de guion]"
    momento: 1
    duracion: 4.5
  - hablante: Espectro del Pavor
    texto: "[Antes del jefe \xB7 Miedo \xB7 pendiente de guion] Espectro del Pavor encarna el miedo."
    momento: 2
    duracion: 4.5
  - hablante: Kael
    texto: "[Cierre \xB7 Miedo \xB7 pendiente de guion] Kael reconoce el miedo como parte de s\xED."
    momento: 3
    duracion: 4.5
